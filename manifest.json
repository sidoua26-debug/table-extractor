{
  "manifest_version": 3,
  "name": "Table Extractor",
  "version": "1.0.0",
  "description": "Detects HTML tables and virtualized data grids on webpages and exports them to CSV, XLSX, and JSON.",
  
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Table Extractor",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },

  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "assets/icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
